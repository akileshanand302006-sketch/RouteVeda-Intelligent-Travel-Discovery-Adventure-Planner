{
  "name": "routeveda",
  "version": "0.0.0",
  "scripts": {
    "ng": "node ./node_modules/@angular/cli/bin/ng.js",
    "start": "node dist-server/index.js",
    "start:client": "node ./node_modules/@angular/cli/bin/ng.js serve",
    "start:server": "node dist-server/index.js",
    "build": "node ./node_modules/typescript/bin/tsc -p server/tsconfig.json",
    "build:client": "node ./node_modules/@angular/cli/bin/ng.js build --configuration production",
    "build:server": "node ./node_modules/typescript/bin/tsc -p server/tsconfig.json",
    "build:prod": "node ./node_modules/@angular/cli/bin/ng.js build --configuration production",
    "watch": "node ./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "test": "ng test",
    "server": "node ./node_modules/tsx/dist/cli.mjs server/src/index.ts",
    "server:build": "node ./node_modules/typescript/bin/tsc -p server/tsconfig.json",
    "server:start": "node dist-server/index.js",
    "db:migrate": "node ./node_modules/tsx/dist/cli.mjs server/src/migrations/migrate.ts",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs server/src/seed/seed.ts",
    "validate-db": "node ./node_modules/tsx/dist/cli.mjs server/src/scripts/validate-db.ts"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@types/animejs": "^3.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "animejs": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "pg": "^8.23.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "vitest": "^4.0.8"
  }
}
