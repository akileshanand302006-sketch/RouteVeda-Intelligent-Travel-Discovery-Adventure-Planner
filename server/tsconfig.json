{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "../dist-server",
    "rootDir": "src",
    "types": ["node", "express", "pg", "cors", "jsonwebtoken", "bcryptjs"]
  },
  "include": ["src/**/*"]
}
