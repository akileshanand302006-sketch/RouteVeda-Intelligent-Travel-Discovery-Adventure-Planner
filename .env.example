# RouteVeda Server Configuration Template
PORT=3000
NODE_ENV=production

# Database Connection (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require

# Security & JWT
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Configuration (Netlify domain in production)
FRONTEND_URL=https://your-routeveda-site.netlify.app
